{
  "name": "memopal-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "apps/admin"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=memopal --",
    "android": "npm run android --workspace=memopal",
    "dev:admin": "npm run dev --workspace=memopal-admin",
    "check": "npm run check:mobile && npm run check:admin",
    "check:mobile": "npm run typecheck --workspace=memopal && npm run lint --workspace=memopal && npm run test --workspace=memopal",
    "test:mobile": "npm run test --workspace=memopal",
    "check:admin": "npm run build --workspace=memopal-admin && npm run lint --workspace=memopal-admin && npm run test --workspace=memopal-admin",
    "build:admin": "npm run build --workspace=memopal-admin"
  },
  "dependencies": {
    "expo-asset": "12.0.13",
    "expo-constants": "18.0.14",
    "expo-router": "6.0.24",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "postcss": "8.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
