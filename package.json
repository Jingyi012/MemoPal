{
  "name": "memopal-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "apps/admin"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=memopal",
    "dev:admin": "npm run dev --workspace=memopal-admin",
    "check": "npm run check:mobile && npm run check:admin",
    "check:mobile": "npm run typecheck --workspace=memopal && npm run lint --workspace=memopal && npm run test --workspace=memopal",
    "test:mobile": "npm run test --workspace=memopal",
    "check:admin": "npm run build --workspace=memopal-admin && npm run lint --workspace=memopal-admin",
    "build:admin": "npm run build --workspace=memopal-admin"
  },
  "dependencies": {
    "expo-asset": "57.0.15",
    "expo-constants": "57.0.16",
    "expo-router": "57.0.17",
    "react-native": "0.87.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.1"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.2.8",
    "react-native-safe-area-context": "5.9.1",
    "react-native-svg": "15.15.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "postcss": "8.5.26",
    "react": "19.1.0",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=22"
  }
}
