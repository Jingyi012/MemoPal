EXPO_PUBLIC_API_BASE_URL=http://localhost:5080/
EXPO_PUBLIC_MEDIA_BASE_URL=http://localhost:5080/files
# Keep false for normal development so memory saves persist through the API.
# Set true only for an intentionally client-only UI preview.
EXPO_PUBLIC_LOCAL_DEV_MODE=false
# Set to true only if you want to use EXPO_PUBLIC_API_BASE_URL exactly as-is
# (no localhost -> device/emulator host mapping in Expo dev).
EXPO_PUBLIC_STRICT_BASE_URL=false

# Google Sign-In
# Required: Web client ID from Google Cloud Console (OAuth 2.0 Client type: Web application)
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=458572178451-tpvo74i8j3qcg40kcjauj8v4610c26rt.apps.googleusercontent.com
# Android also requires an OAuth 2.0 Android client in Google Cloud Console
# with package name com.memopal.app and the SHA-1 of every signing certificate
# used by the app (debug, internal, and production). The native SDK resolves
# this Android client from the package name and certificate; do not put its ID here.
# Optional: iOS client ID (OAuth 2.0 Client type: iOS)
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=458572178451-q0toa23kaimdebtrhihst5hroo9eqnab.apps.googleusercontent.com
# Optional: Google Workspace hosted domain restriction (example: yourcompany.com)
EXPO_PUBLIC_GOOGLE_OAUTH_HOSTED_DOMAIN=
