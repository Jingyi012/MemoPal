# Required: used to resolve GHCR image names in docker-compose.yml
IMAGE_OWNER=your-github-username-or-org

# Database settings. Keep this file private on the server after copying it to
# .env, and use absolute host paths for both persistent data directories.
POSTGRES_DB=memopal
POSTGRES_USER=memopal
POSTGRES_PASSWORD=replace-with-strong-password

# PostgreSQL data is mounted at /var/lib/postgresql/data in the db container.
POSTGRES_DATA_PATH=/opt/memopal/postgresql/data

# Uploaded media is mounted at /data/uploads in the API container.
MEMOPAL_UPLOADS_PATH=/opt/memopal/uploads

# Set to true to apply pending EF Core migrations during API startup.
Database__ApplyMigrationsOnStartup=true
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
FileStorage__RootPath=/data/uploads

# For direct external DB access (Option 2), keep 0.0.0.0.
# For private DB (SSH tunnel), use 127.0.0.1.
DB_BIND_HOST=0.0.0.0
DB_HOST_PORT=15432
API_BIND_HOST=127.0.0.1
API_HOST_PORT=18080
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=18081

# Optional: default to latest if omitted.
BACKEND_IMAGE_TAG=latest
ADMIN_IMAGE_TAG=latest

# MemoPal API runtime config
Jwt__Issuer=MemoPal
Jwt__Audience=MemoPal.Mobile
Jwt__Secret=replace-with-long-random-secret-at-least-32-chars
Jwt__ExpiryMinutes=2592000
MediaUrl__BaseUrl=https://memopal-api.cheehong.cloud
MediaUrl__DiagnosticsEnabled=false
Cors__AllowedOrigins__0=https://memopal-admin.cheehong.cloud
AdminBootstrap__Enabled=false
AdminBootstrap__SeedGamificationMockData=false
BillingWebhook__Secret=replace-with-webhook-secret
