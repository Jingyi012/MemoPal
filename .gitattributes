* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Palace authoring source imagery is intentionally versioned through Git LFS.
palaceData/**/*.png filter=lfs diff=lfs merge=lfs -text
palaceData/**/*.jpg filter=lfs diff=lfs merge=lfs -text
palaceData/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
